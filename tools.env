# The node tools this engine is known to work with, and the versions it was checked against.
# `vysu setup` and `vysu update` install `<tool>@latest` when the machine is below one of them;
# `vysu doctor` says so without touching anything. Raise a line here when the engine starts
# relying on something newer — that is the whole contract between vysu and its two drivers.
AGENT_BROWSER_MIN=0.38.1
AGENT_DEVICE_MIN=0.21.6
