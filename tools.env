# The node tools this engine is known to work with, and the versions it was checked against.
# `vysu setup` and `vysu update` install `<tool>@latest` when the machine is below one of them;
# `vysu doctor` says so without touching anything. Raise a line here when the engine starts
# relying on something newer — that is the whole contract between vysu and its two drivers. A MAX
# line holds a tool back from a release that breaks the engine: setup and update install that one
# instead of `@latest`, doctor warns above it.
AGENT_BROWSER_MIN=0.38.2
AGENT_DEVICE_MIN=0.21.6
# 0.21.9 to 0.21.26 (latest checked): iOS presses fail with point.x != INFINITY under iOS 26 glass,
# the runner anchoring them on an app frame XCTest reads as null (vysu #11).
AGENT_DEVICE_MAX=0.21.8
