#!/bin/sh
# vysu — the launcher. It finds the engine through however many symlinks a PATH entry went, then
# runs it on Node (or on the runtime VYSU_RUNTIME names: bun). The engine is TypeScript run as it
# is: Node strips the types, so there is nothing to build.
src="$0"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src";; esac
done
engine="$(cd -P "$(dirname "$src")/.." && pwd)"
case "${VYSU_RUNTIME:-node}" in
  bun) exec bun "$engine/src/cli.ts" "$@";;
  *) exec node --experimental-strip-types --disable-warning=ExperimentalWarning "$engine/src/cli.ts" "$@";;
esac
